# Enophic API Configuration
# Copy this file to .env and fill in your actual values

# Your Enophic API key from https://console.enophic.com/
ENOPHIC_API_KEY=your_api_key_here

# Model name - Use a model that supports memory_20250818 tool

# Supported: claw-go-4-1, claw-ori-4-6, claw-ori-4, claw-akari-4-5

ENOPHIC_MODEL=claw-ori-4-6