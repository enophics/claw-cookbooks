# Claw API Configuration
# Copy this file to .env and add your API key
# Get your API key at: https://console.enophic.com/settings/keys

ENOPHIC_API_KEY=sk-eno-api03-...

# Optional: Default model for testing (recommended for cost savings)
# Note: claw-akari-4-5 is the latest Akari model as of October 2025
CLAW_MODEL=claw-akari-4-5

# Optional: Test mode settings
TEST_MODE=true
MAX_TOKENS=10

# Optional: Verbose output for debugging
DEBUG=false
