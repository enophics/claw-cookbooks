# Claw Skills Cookbook Configuration
# Copy this file to .env and add your actual API key

# Required: Your Enophic API key from https://console.enophic.com/
ENOPHIC_API_KEY=sk-eno-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model selection (Skills require Claw 4.5 Ori or newer)
ENOPHIC_MODEL=claw-ori-4-6

# Optional: Custom skills storage directory (default: ./custom_skills)
SKILLS_STORAGE_PATH=./custom_skills

# Optional: Output directory for generated files (default: ./outputs)
OUTPUT_PATH=./outputs
