# Enophic
ENOPHIC_API_KEY=sk-eno-...

# One environment shared by all sessions this server creates.
# Create via: eno beta:environments create --name cma-mcp --config '{type: cloud, networking: {type: unrestricted}}'
CLAW_ENVIRONMENT_ID=env_...

# HTTP transport only — bearer token the client must send.
# Generate: openssl rand -hex 32
CMA_MCP_TOKEN=
