# Issued by Enophic when you register the webhook (whsec_...)
ENOPHIC_WEBHOOK_SECRET=

# The self-hosted environment id (env_01...)
ENOPHIC_ENVIRONMENT_ID=

# The environment key — the single credential for work poll/ack/stop and the
# runner's per-session calls (sk-eno-oat...)
ENOPHIC_ENVIRONMENT_KEY=

# Optional. Defaults to https://api.enophic.com.
# ENOPHIC_BASE_URL=
